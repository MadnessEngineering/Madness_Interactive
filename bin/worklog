#!/bin/sh
# worklog — your commits across every repo under a folder, grouped by day.
#
#   worklog [-C DIR]... [-a AUTHOR] [-c] [SINCE [UNTIL]]
#
# SINCE/UNTIL take any date git understands: monday, "2 weeks ago", 2026-10-01,
# "yesterday midnight" (plain "yesterday" means 24 hours ago). Default: since
# midnight today. Dates are when the work was authored, so rebased or
# cherry-picked commits stay on the day they were written. Each day shows its
# commit count and first–last commit time (a rough span for timesheets).
#   -C DIR     folder to scan for repos, repeatable (default: .)
#   -a AUTHOR  default: git config user.name
#   -c         counts only: one line per day per repo
# Scans 5 levels deep, so submodules and nested projects count; git worktrees
# are skipped (same commits). Commits on any branch count; merges don't.
#
#   worklog                       # today
#   worklog "yesterday midnight" midnight   # standup
#   worklog -C ~/lab -C ~/.hammerspoon 2026-10-01 2026-10-16

usage() { sed -n '2,20s/^# \{0,1\}//p' "$0" >&2; exit 2; }

roots= author= counts=
while getopts C:a:ch opt; do
    case $opt in
        C) roots="$roots
$OPTARG" ;;
        a) author=$OPTARG ;;
        c) counts=1 ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))
[ $# -le 2 ] || usage
since=${1:-midnight}
until=${2:-}
[ -n "$roots" ] || roots=.
[ -n "$author" ] || author=$(git config user.name)
[ -n "$author" ] || { echo "worklog: no author (git config user.name, or -a)" >&2; exit 1; }

# Turn SINCE/UNTIL into epoch seconds using git's own date parser.
since_ts=$(git rev-parse --since="$since" | sed 's/^--max-age=//')
until_ts=
[ -n "$until" ] && until_ts=$(git rev-parse --until="$until" | sed 's/^--min-age=//')

printf '%s\n' "$roots" | while IFS= read -r root; do
    [ -n "$root" ] || continue
    find "$root" -maxdepth 5 \( -name node_modules -o -name .venv -o -name Library \) -prune \
        -o -name .git -print 2>/dev/null
done | WL_AUTHOR=$author WL_SINCE=$since_ts xargs -P 8 -I{} sh -c '
    gitpath=$1
    # A .git *file* pointing into .../worktrees/ is a worktree of a repo we scan anyway.
    [ -f "$gitpath" ] && grep -q "/worktrees/" "$gitpath" && exit 0
    repo=$(dirname "$gitpath")
    name=$(basename "$(cd "$repo" && pwd)")
    # --since filters on commit date, which is never earlier than author date,
    # so it is a safe pre-filter; awk below filters precisely on author date.
    git -C "$repo" log --all --no-merges --author="$WL_AUTHOR" --since="@$WL_SINCE" \
        --date=format:"%Y-%m-%d %a %H:%M" \
        --format="%at%x09%H%x09%ad%x09$name%x09%s" 2>/dev/null
' _ {} | sort -n | awk -F '\t' -v counts="$counts" -v lo="$since_ts" -v hi="$until_ts" '
    function flush_day() {
        if (day == "") return
        printf "\n## %s  (%d commits, %s–%s)\n", day, n, first, last
        if (counts) for (r in per) printf "  %-22s %d\n", r, per[r]
        else printf "%s", body
        split("", per); body = ""; n = 0
    }
    $1 < lo || (hi != "" && $1 > hi) || seen[$2]++ { next }
    {
        d = substr($3, 1, 14); t = substr($3, 16)
        if (d != day) { flush_day(); day = d; first = t }
        last = t; n++; per[$4]++; total++
        body = body sprintf("  %s  %-22s %s\n", t, $4, $5)
    }
    END {
        flush_day()
        if (total == 0) print "no commits"
    }'
