#!/bin/sh
# netwatch — ping a host forever, report only when it goes up or down.
#
#   netwatch [-i SECS] [-f FAILS] [-x CMD] HOST
#
# Checks every SECS (default 6). Marks the host down after FAILS misses in a
# row (default 2, so one dropped ping isn't an outage), up on the first reply.
# On each change it prints a timestamped line and publishes, retained:
#   netwatch/HOST/status   up | down
#   netwatch/HOST/since    2026-10-19T18:40:00
# -x CMD runs through sh -c on each change, with NETWATCH_HOST and
# NETWATCH_STATE set.
#
# Broker: MQTT_HOST:MQTT_PORT, defaulting to AWSIP:AWSPORT. Optional
# MQTT_USER / MQTT_PASS. NETWATCH_NO_MQTT=1 skips publishing.
#
#   netwatch 192.168.1.1
#   netwatch -i 30 -x 'say "$NETWATCH_HOST is $NETWATCH_STATE"' github.com

usage() { sed -n '2,19s/^# \{0,1\}//p' "$0" >&2; exit 2; }

interval=6 fails_needed=2 on_change=
while getopts i:f:x:h opt; do
    case $opt in
        i) interval=$OPTARG ;;
        f) fails_needed=$OPTARG ;;
        x) on_change=$OPTARG ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))
[ $# -eq 1 ] || usage
host=$1

mqtt_host=${MQTT_HOST:-$AWSIP}
mqtt_port=${MQTT_PORT:-${AWSPORT:-1883}}
if [ -z "$NETWATCH_NO_MQTT" ] && [ -z "$mqtt_host" ]; then
    echo "netwatch: no broker (set MQTT_HOST or AWSIP, or NETWATCH_NO_MQTT=1)" >&2
    exit 1
fi

# One ping, two-second wait. The timeout flag differs between BSD and Linux.
case $(uname) in
    Darwin|*BSD) ping_once() { ping -c 1 -t 2 "$host" >/dev/null 2>&1; } ;;
    *)           ping_once() { ping -c 1 -W 2 "$host" >/dev/null 2>&1; } ;;
esac

publish() {
    [ -n "$NETWATCH_NO_MQTT" ] && return
    set -- -h "$mqtt_host" -p "$mqtt_port" -r -t "netwatch/$host/$1" -m "$2"
    [ -n "$MQTT_USER" ] && set -- "$@" -u "$MQTT_USER" -P "$MQTT_PASS"
    mosquitto_pub "$@" || echo "netwatch: publish failed" >&2
}

state= misses=0
while :; do
    if ping_once; then
        misses=0 new=up
    else
        misses=$((misses + 1))
        if [ $misses -ge "$fails_needed" ] || [ -z "$state" ]; then new=down; else new=$state; fi
    fi

    if [ "$new" != "$state" ]; then
        state=$new
        stamp=$(date '+%Y-%m-%dT%H:%M:%S')
        echo "$stamp  $host  $state"
        publish status "$state"
        publish since "$stamp"
        [ -n "$on_change" ] &&
            NETWATCH_HOST=$host NETWATCH_STATE=$state sh -c "$on_change" </dev/null
    fi
    sleep "$interval"
done
